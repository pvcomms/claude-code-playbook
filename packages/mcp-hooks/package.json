{
  "name": "@paramxclaudedev/mcp-hooks",
  "version": "0.1.0",
  "description": "MCP server for managing Claude Code hooks in ~/.claude/settings.json. Inspect events, matchers, and commands.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hooks-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "hooks",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/paramxclaudedev/claude-code-playbook",
    "directory": "packages/mcp-hooks"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
